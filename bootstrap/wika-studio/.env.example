# ----------------------------------------------------------------------------
# WIKA Studio — configuración del BFF (copiar a .env; .env está en .gitignore)
# ----------------------------------------------------------------------------

# Dueños autorizados (emails separados por coma). Nadie más puede entrar.
STUDIO_OWNERS=dueno@example.com

# Hash de la contraseña compartida de dueños. En Windows usa:
#   node scripts/write-owner-env.mjs --email tu@correo --password "tu-clave"
# (reescribe este archivo en UTF-8). Alternativa: node scripts/hash-password.mjs "tu-clave"
STUDIO_PASSWORD_HASH=

# API key de Cursor (Dashboard → API Keys). Solo vive en el servidor.
# Si falta, el BFF arranca con runtime "mock" (sin IA real) para desarrollo.
CURSOR_API_KEY=

# Runtime de agentes: cursor-sdk | mock. Por defecto: cursor-sdk si hay API key.
# STUDIO_AGENT_RUNTIME=cursor-sdk

# Ruta al repo `proyectos` (debe contener app/). Default: fixtures/proyectos
# WIKA_PROYECTOS_ROOT=C:/Users/yo/proyectos

# Ruta al clon de wika-fundaments (agents/, .cursorrules, templates/).
# Default: se detecta ../wika-fundaments o la raíz que contiene bootstrap/.
# WIKA_FUNDAMENTS_ROOT=C:/Users/yo/wika-fundaments

# Red: el BFF escucha solo en localhost por defecto.
# HOST=127.0.0.1
# PORT=3001
# STUDIO_WEB_ORIGIN=http://localhost:5173

# Rango de puertos para previews de iteraciones.
# STUDIO_PREVIEW_PORTS=4300-4399

# Duración de la sesión de dueño (horas).
# STUDIO_SESSION_TTL_HOURS=12

# Carpeta de estado local (settings, sesiones). Default: .data/
# STUDIO_DATA_DIR=.data
