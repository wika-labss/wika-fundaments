{
  "expo": {
    "name": "Prototipo WIKA",
    "slug": "wika-prototype",
    "version": "0.1.0",
    "scheme": "wikaprototype",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "platforms": ["android", "web"],
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "android": {
      "package": "com.wika.prototype"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
