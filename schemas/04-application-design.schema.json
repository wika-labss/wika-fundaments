{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wika.local/schemas/04-application-design.schema.json",
  "title": "WIKA 04-application-design frontmatter",
  "type": "object",
  "required": [
    "id",
    "title",
    "status",
    "version",
    "owner",
    "audit_1_passed",
    "audit_2_passed",
    "visual_approval_passed",
    "audit_3_passed"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^DES-" },
    "title": { "type": "string", "minLength": 1 },
    "status": { "enum": ["BORRADOR", "REVISION", "APROBADO"] },
    "version": { "type": "string" },
    "owner": { "type": "string" },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" },
    "audit_1_passed": { "type": "boolean" },
    "audit_2_passed": { "type": "boolean" },
    "visual_approval_passed": { "type": "boolean" },
    "audit_3_passed": { "type": "boolean" },
    "preview_evidence_url": { "type": "string" }
  },
  "additionalProperties": true
}
