# Copia a .env (gitignored). No pongas secretos reales en git.

# Subdominio Scraping TA. DNS: A  ta  → IP del VPS.
DOMAIN=ta.vissiuss.com

# Let's Encrypt. Usa un correo real que controles.
ACME_EMAIL=ops@vissiuss.com

# Clave de la extensión (Bearer). Generar: openssl rand -hex 32
INGEST_KEY=

# Token ScrapingBee — opcional, solo fallback si la extensión no puede capturar.
SCRAPINGBEE_API_KEY=

# Admin consola (cambiar antes de publicar).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambiar123
SCRAPING_TA_AUTH=1
SCRAPING_TA_AGENT_URL=
